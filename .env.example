# Environment Variables for Publishing
# Copy this file to .env and fill in your values

# GitHub Token (required for GitHub releases)
# Create at: https://github.com/settings/tokens
# Required scopes: repo (for release creation and asset upload)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CurseForge API Token (optional, for CurseForge uploads)
# Get from: https://console.curseforge.com/ (API Tokens section)
CF_API_TOKEN=your_curseforge_api_token_here

# CurseForge Project ID (required if uploading to CurseForge)
# Find in your project's URL: curseforge.com/minecraft/mc-mods/[slug]/files -> project ID in sidebar
CF_PROJECT_ID=123456

# Optional CurseForge settings
# CF_RELEASE_TYPE=release
# CF_MOD_LOADER=NeoForge
